@{
    ViewData["Title"] = "Inicio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gastos Personales</h1>

    <a asp-controller="Movimientos"
       asp-action="Create"
       class="btn btn-primary">
        Nuevo Movimiento
    </a>
</div>

<p class="text-muted mb-4">
    Resumen de tus ingresos, gastos y presupuestos.
</p>


<table class="table table-bordered table-hover mb-4">

    <thead class="table-dark">
        <tr>
            <th>
                Ingresos
            </th>
            <th>
                Gastos
            </th>
            <th>
                Balance
            </th>
            <th>
                Movimientos
            </th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>
                <span class="text-success fw-bold">
                    $ @ViewBag.Ingresos.ToString("F2")
                </span>
            </td>

            <td>
                <span class="text-danger fw-bold">
                    $ @ViewBag.Gastos.ToString("F2")
                </span>
            </td>

            <td>
                <span class="@(ViewBag.Balance >= 0 ? "text-success" : "text-danger") fw-bold">
                    $ @ViewBag.Balance.ToString("F2")
                </span>
            </td>

            <td>
                @ViewBag.CantidadMovimientos
            </td>
        </tr>
    </tbody>

</table>


<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Accesos rápidos</h3>
</div>

<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>
                Sección
            </th>
            <th>
                Descripción
            </th>
            <th>
                Acción
            </th>
        </tr>
    </thead>

    <tbody>

        <tr>
            <td>
                Mi perfil
            </td>

            <td>
                Consulta y modifica la información de tu cuenta.
            </td>

            <td>
                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="btn btn-info btn-sm">
                    Ver perfil
                </a>
            </td>
        </tr>

        <tr>
            <td>
                Categorías
            </td>

            <td>
                Consulta y administra las categorías de tus movimientos.
            </td>

            <td>
                <a asp-controller="Categorias"
                   asp-action="Index"
                   class="btn btn-info btn-sm">
                    Ver categorías
                </a>
            </td>
        </tr>

        <tr>
            <td>
                Movimientos
            </td>

            <td>
                Consulta tus ingresos y gastos registrados.
            </td>

            <td>
                <a asp-controller="Movimientos"
                   asp-action="Index"
                   class="btn btn-info btn-sm">
                    Ver movimientos
                </a>
            </td>
        </tr>

        <tr>
            <td>
                Presupuestos
            </td>

            <td>
                Consulta y administra tus límites de gasto.
            </td>

            <td>
                <a asp-controller="Presupuestos"
                   asp-action="Index"
                   class="btn btn-info btn-sm">
                    Ver presupuestos
                </a>
            </td>
        </tr>

    </tbody>

</table>