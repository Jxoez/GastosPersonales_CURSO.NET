@model IEnumerable<GastosPersonales.Modelos.Movimiento>

@{
    ViewData["Title"] = "Movimientos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Movimientos</h1>

    <a asp-action="Create" class="btn btn-primary">
        Nuevo Movimiento
    </a>
</div>

<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>
                Descripción
            </th>
            <th>
                Monto
            </th>
            <th>
                Fecha
            </th>
            <th>
                Tipo
            </th>
            <th>
                Usuario
            </th>
            <th>
                Categoría
            </th>
            <th>
                Acciones
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.descripcion)
                </td>

                <td>
                    $ @item.monto
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.fecha)
                </td>

                <td>
                    @if (item.tipo == "Gasto")
                    {
                        <span class="badge bg-danger">Gasto</span>
                    }
                    else if (item.tipo == "Ingreso")
                    {
                        <span class="badge bg-success">Ingreso</span>
                    }
                    else
                    {
                        @Html.DisplayFor(modelItem => item.tipo)
                    }
                </td>

                <td>
                    @if (item.Usuario != null)
                    {
                        @($"{item.Usuario.nombre} {item.Usuario.apellido}")
                    }
                    else
                    {
                        <span class="text-muted">Sin usuario</span>
                    }
                </td>

                <td>
                    @if (item.Categoria != null)
                    {
                        @item.Categoria.nombre
                    }
                    else
                    {
                        <span class="text-muted">Sin categoría</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-idmovimiento="@item.idMovimiento"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Details"
                       asp-route-idmovimiento="@item.idMovimiento"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Delete"
                       asp-route-idmovimiento="@item.idMovimiento"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>

</table>