@model IEnumerable<GastosPersonales.Modelos.Movimiento>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.monto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idUsuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idCategoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categoria)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.monto)
            </td>
            <td>
                @Html.DisplayFor(model => item.fecha)
            </td>
            <td>
                @Html.DisplayFor(model => item.tipo)
            </td>
            <td>
                @Html.DisplayFor(model => item.idUsuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.idCategoria)
            </td>
            <td>
                @Html.DisplayFor(model => item.Usuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Categoria)
            </td>
            <td>
                <a asp-action="Edit" asp-route-idmovimiento="@item.idMovimiento">Edit</a> |
                <a asp-action="Details" asp-route-idmovimiento="@item.idMovimiento">Details</a> |
                <a asp-action="Delete" asp-route-idmovimiento="@item.idMovimiento">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
