@model GastosPersonales.Modelos.Movimiento

@{
    ViewData["Title"] = "Eliminar Movimiento";
}

<h1>Eliminar Movimiento</h1>

<h4>¿Está seguro de que desea eliminar este movimiento?</h4>

<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Descripción
            </dt>

            <dd class="col-sm-8">
                @Model.descripcion
            </dd>

            <dt class="col-sm-4">
                Monto
            </dt>

            <dd class="col-sm-8">
                $ @Model.monto.ToString("F2")
            </dd>

            <dt class="col-sm-4">
                Fecha
            </dt>

            <dd class="col-sm-8">
                @Model.fecha.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-4">
                Tipo
            </dt>

            <dd class="col-sm-8">
                @if (Model.tipo == "Gasto")
                {
                    <span class="badge bg-danger">Gasto</span>
                }
                else if (Model.tipo == "Ingreso")
                {
                    <span class="badge bg-success">Ingreso</span>
                }
                else
                {
                    @Model.tipo
                }
            </dd>

            <dt class="col-sm-4">
                Categoría
            </dt>

            <dd class="col-sm-8">
                @if (Model.Categoria != null)
                {
                    @Model.Categoria.nombre
                }
                else
                {
                    <span class="text-muted">Sin categoría</span>
                }
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">

    <form asp-action="Delete" class="d-inline">

        <input type="hidden" asp-for="idMovimiento" />

        <input type="submit"
               value="Eliminar"
               class="btn btn-danger" />

    </form>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>