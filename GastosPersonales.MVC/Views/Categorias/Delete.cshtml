@model GastosPersonales.Modelos.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<h1>Eliminar Categoría</h1>

<h4>¿Está seguro de que desea eliminar esta categoría?</h4>

<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Nombre
            </dt>

            <dd class="col-sm-8">
                @Model.nombre
            </dd>

            <dt class="col-sm-4">
                Tipo
            </dt>

            <dd class="col-sm-8">
                @if (Model.tipo == "Gasto")
                {
                    <span class="badge bg-danger">Gasto</span>
                }
                else if (Model.tipo == "Ingreso")
                {
                    <span class="badge bg-success">Ingreso</span>
                }
                else
                {
                    @Model.tipo
                }
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">

    <form asp-action="Delete" class="d-inline">

        <input type="hidden" asp-for="idCategoria" />

        <input type="submit"
               value="Eliminar"
               class="btn btn-danger" />

    </form>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>