@model GastosPersonales.Modelos.Categoria

@{
    ViewData["Title"] = "Detalles de Categoría";
}

<h1>Detalles de Categoría</h1>

<h4>Información de la Categoría</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Nombre
            </dt>

            <dd class="col-sm-8">
                @Model.nombre
            </dd>

            <dt class="col-sm-4">
                Tipo
            </dt>

            <dd class="col-sm-8">
                @if (Model.tipo == "Gasto")
                {
                    <span class="badge bg-danger">Gasto</span>
                }
                else if (Model.tipo == "Ingreso")
                {
                    <span class="badge bg-success">Ingreso</span>
                }
                else
                {
                    @Model.tipo
                }
            </dd>

        </dl>

    </div>
</div>

<hr />

<h5>Presupuestos asociados</h5>

@if (Model.Presupuestos != null && Model.Presupuestos.Any())
{
    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>Mes</th>
                <th>Año</th>
                <th>Monto Límite</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var presupuesto in Model.Presupuestos)
            {
                <tr>
                    <td>
                        @switch (presupuesto.mes)
                        {
                            case 1: <span>Enero</span> break;
                            case 2: <span>Febrero</span> break;
                            case 3: <span>Marzo</span> break;
                            case 4: <span>Abril</span> break;
                            case 5: <span>Mayo</span> break;
                            case 6: <span>Junio</span> break;
                            case 7: <span>Julio</span> break;
                            case 8: <span>Agosto</span> break;
                            case 9: <span>Septiembre</span> break;
                            case 10: <span>Octubre</span> break;
                            case 11: <span>Noviembre</span> break;
                            case 12: <span>Diciembre</span> break;
                            default: <span>Desconocido</span> break;
                        }
                    </td>

                    <td>
                        @presupuesto.anio
                    </td>

                    <td>
                        $ @presupuesto.montoLimite.ToString("F2")
                    </td>
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <p class="text-muted">
        No existen presupuestos asociados a esta categoría.
    </p>
}

<hr />

<h5>Movimientos asociados</h5>

@if (Model.Movimientos != null && Model.Movimientos.Any())
{
    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>Descripción</th>
                <th>Monto</th>
                <th>Fecha</th>
                <th>Tipo</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var movimiento in Model.Movimientos)
            {
                <tr>

                    <td>
                        @movimiento.descripcion
                    </td>

                    <td>
                        $ @movimiento.monto.ToString("F2")
                    </td>

                    <td>
                        @movimiento.fecha.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @if (movimiento.tipo == "Gasto")
                        {
                            <span class="badge bg-danger">Gasto</span>
                        }
                        else if (movimiento.tipo == "Ingreso")
                        {
                            <span class="badge bg-success">Ingreso</span>
                        }
                        else
                        {
                            @movimiento.tipo
                        }
                    </td>

                </tr>
            }
        </tbody>

    </table>
}
else
{
    <p class="text-muted">
        No existen movimientos asociados a esta categoría.
    </p>
}

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-idcategoria="@Model.idCategoria"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>