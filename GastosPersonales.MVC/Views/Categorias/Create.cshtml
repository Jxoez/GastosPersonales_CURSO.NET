@model GastosPersonales.Modelos.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
}

<h1>Crear Categoría</h1>

<h4>Nueva Categoría</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="nombre" class="control-label">Nombre de la Categoría</label>
                <input asp-for="nombre" class="form-control" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="tipo" class="control-label">Tipo</label>

                <select asp-for="tipo" class="form-control">
                    <option value="">-- Seleccione el Tipo --</option>
                    <option value="Gasto">Gasto</option>
                    <option value="Ingreso">Ingreso</option>
                </select>

                <span asp-validation-for="tipo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar Categoría" class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}