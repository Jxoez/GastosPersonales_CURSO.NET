@model IEnumerable<GastosPersonales.Modelos.Presupuesto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.montoLimite)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.mes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.anio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idUsuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idCategoria)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Categoria)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.montoLimite)
            </td>
            <td>
                @Html.DisplayFor(model => item.mes)
            </td>
            <td>
                @Html.DisplayFor(model => item.anio)
            </td>
            <td>
                @Html.DisplayFor(model => item.idUsuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.idCategoria)
            </td>
            <td>
                @Html.DisplayFor(model => item.Usuario)
            </td>
            <td>
                @Html.DisplayFor(model => item.Categoria)
            </td>
            <td>
                <a asp-action="Edit" asp-route-idpresupuesto="@item.idPresupuesto">Edit</a> |
                <a asp-action="Details" asp-route-idpresupuesto="@item.idPresupuesto">Details</a> |
                <a asp-action="Delete" asp-route-idpresupuesto="@item.idPresupuesto">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
