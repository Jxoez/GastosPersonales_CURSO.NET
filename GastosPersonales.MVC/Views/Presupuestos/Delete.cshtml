@model GastosPersonales.Modelos.Presupuesto

@{
    ViewData["Title"] = "Eliminar Presupuesto";
}

<h1>Eliminar Presupuesto</h1>

<h4>¿Está seguro de que desea eliminar este presupuesto?</h4>

<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Límite
            </dt>

            <dd class="col-sm-8">
                $ @Model.montoLimite.ToString("F2")
            </dd>

            <dt class="col-sm-4">
                Mes
            </dt>

            <dd class="col-sm-8">
                @Model.mes
            </dd>

            <dt class="col-sm-4">
                Año
            </dt>

            <dd class="col-sm-8">
                @Model.anio
            </dd>

            <dt class="col-sm-4">
                Categoría
            </dt>

            <dd class="col-sm-8">
                @if (Model.Categoria != null)
                {
                    @Model.Categoria.nombre
                }
                else
                {
                    <span class="text-muted">Sin categoría</span>
                }
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">

    <form asp-action="Delete" class="d-inline">

        <input type="hidden" asp-for="idPresupuesto" />

        <input type="submit"
               value="Eliminar"
               class="btn btn-danger" />

    </form>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>