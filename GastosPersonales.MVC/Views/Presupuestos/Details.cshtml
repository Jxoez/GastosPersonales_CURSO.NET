@model GastosPersonales.Modelos.Presupuesto

@{
    ViewData["Title"] = "Detalles del Presupuesto";
}

<h1>Detalles del Presupuesto</h1>

<h4>Información del Presupuesto</h4>
<hr />

<div class="row">
    <div class="col-md-6">

        <dl class="row">

            <dt class="col-sm-4">
                Monto Límite
            </dt>

            <dd class="col-sm-8">
                $ @Model.montoLimite.ToString("F2")
            </dd>

            <dt class="col-sm-4">
                Mes
            </dt>

            <dd class="col-sm-8">
                @switch (Model.mes)
                {
                    case 1:
                        <span>Enero</span>
                        break;
                    case 2:
                        <span>Febrero</span>
                        break;
                    case 3:
                        <span>Marzo</span>
                        break;
                    case 4:
                        <span>Abril</span>
                        break;
                    case 5:
                        <span>Mayo</span>
                        break;
                    case 6:
                        <span>Junio</span>
                        break;
                    case 7:
                        <span>Julio</span>
                        break;
                    case 8:
                        <span>Agosto</span>
                        break;
                    case 9:
                        <span>Septiembre</span>
                        break;
                    case 10:
                        <span>Octubre</span>
                        break;
                    case 11:
                        <span>Noviembre</span>
                        break;
                    case 12:
                        <span>Diciembre</span>
                        break;
                    default:
                        <span>Mes no válido</span>
                        break;
                }
            </dd>

            <dt class="col-sm-4">
                Año
            </dt>

            <dd class="col-sm-8">
                @Model.anio
            </dd>

            <dt class="col-sm-4">
                Usuario
            </dt>

            <dd class="col-sm-8">
                @if (Model.Usuario != null)
                {
                    @($"{Model.Usuario.nombre} {Model.Usuario.apellido}")
                }
                else
                {
                    <span class="text-muted">Sin usuario</span>
                }
            </dd>

            <dt class="col-sm-4">
                Categoría
            </dt>

            <dd class="col-sm-8">
                @if (Model.Categoria != null)
                {
                    @Model.Categoria.nombre
                }
                else
                {
                    <span class="text-muted">Sin categoría</span>
                }
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-idpresupuesto="@Model.idPresupuesto"
       class="btn btn-warning">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>

</div>